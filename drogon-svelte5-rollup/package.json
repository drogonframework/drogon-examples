{
    "name": "drogon-svelte5-rollup",
    "private": true,
    "type": "module",
    "scripts": {
        "build::views": "concurrently \"node ./assets-sync.js --once\" \"rollup --config ./rollup.config.js --bundleConfigAsCjs\"",
        "watch::views": "concurrently \"node ./assets-sync.js\" \"rollup --config ./rollup.config.js --bundleConfigAsCjs --watch\"",
        "bun::build::views": "concurrently \"bun run --bun ./assets-sync.js --once\" \"rollup --config ./rollup.config.js --bundleConfigAsCjs\"",
        "bun::watch::views": "concurrently \"bun run --bun ./assets-sync.js\" \"rollup --config ./rollup.config.js --bundleConfigAsCjs --watch\"",
        "build::views::old": "rollup --config ./rollup.config.js --bundleConfigAsCjs",
        "watch::views::old": "rollup --config ./rollup.config.js --bundleConfigAsCjs --watch"
    },
    "devDependencies": {
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/estree": "^1.0.7",
        "@types/minimatch": "^5.1.2",
        "chokidar": "^4.0.3",
        "concurrently": "^9.1.2",
        "fs-extra": "^11.3.0",
        "rollup": "^4.41.1",
        "rollup-plugin-progress": "^1.1.2",
        "rollup-plugin-scss": "^4.0.1",
        "rollup-plugin-svelte": "^7.2.2",
        "sass": "^1.89.0",
        "svelte": "^5.33.10",
        "svelte-preprocess": "^6.0.3"
    }
}
